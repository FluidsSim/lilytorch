<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world">
    <model name="toy_boat_small">
      <pose>0 0 0 0 0 0</pose>
      <!-- SCALED-DOWN copy of toy_boat.sdf (S=0.1): every length ×0.1, mass ×1e-3,
           inertia ×1e-5.  Propeller dropped (irrelevant to the waterline test).
           Mesh <scale> 0.0026970 ×0.1 = 0.00026970 -> hull length 0.604 m.
           Controlled experiment: is the boat's instability size/resolution
           (then a small well-resolved boat is stable) or the multi-body mesh
           (then it still explodes)? -->

      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.22206 0.03664 0 0 0 0</pose>
          <mass>0.6</mass>
          <inertia><ixx>0.0029</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>0.02045</iyy><iyz>0</iyz><izz>0.01845</izz></inertia>
        </inertial>
        <collision name="hull_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
        </collision>
        <visual name="hull_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>

      <link name="keel_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.24653 -0.02729 0 0 0 0</pose>
          <mass>0.18</mass>
          <inertia><ixx>5.64e-5</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>2.98e-4</iyy><iyz>0</iyz><izz>3.46e-4</izz></inertia>
        </inertial>
        <collision name="keel_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
        </collision>
        <visual name="keel_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
        </visual>
      </link>

      <link name="rudder_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.02113 0.00233 0 0 0 0</pose>
          <mass>0.02</mass>
          <inertia><ixx>8.6e-6</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>2.0e-6</iyy><iyz>0</iyz><izz>1.06e-5</izz></inertia>
        </inertial>
        <collision name="rudder_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
        </collision>
        <visual name="rudder_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.00026970 0.00026970 0.00026970</scale></mesh></geometry>
          <material><ambient>0.7 0.2 0.15 1</ambient><diffuse>0.7 0.2 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_keel" type="fixed">
        <parent>base_link</parent><child>keel_link</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_rudder" type="fixed">
        <parent>base_link</parent><child>rudder_link</child><pose>0 0 0 0 0 0</pose>
      </joint>
    </model>
  </world>
</sdf>
