#!/usr/bin/env python3
"""
plot_particles_robot.py — Lagrangian dye-particle visualisation from HDF5 data.

Reads ``fields.h5`` (and optionally ``contours.h5``) produced by the lilytorch
solver, seeds tracer particles (e.g. from a body contour or a user-defined
region), advects them with the saved velocity field, and renders each frame
as a PNG.

Supports:
  * 2-D simulations (x-y plane).
  * 3-D simulations with a **top-view** (x-y) projection — directly
    comparable to an overhead camera filming dye release on a real robot.
  * Side-by-side overlay of experimental dye images (from an overhead camera)
    next to the simulated particles.

Usage examples
--------------
  # 2-D, seed particles from tail contour
  python plot_particles_robot.py --sim_dir /data/.../2026-03-XX/

  # 3-D, top-view projection (integrate over z), compare with experiment
  python plot_particles_robot.py \\
      --sim_dir /data/.../2026-03-XX/ \\
      --mode 3d_topview \\
      --exp_dir /path/to/experiment_frames/ \\
      --exp_pattern "frame_{:06d}.png"
"""

from __future__ import annotations

import argparse
import glob
import os
import re
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional, Sequence

import h5py
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors
import numpy as np
import torch
from pytorch_interpolation import RegularGridInterpolator, RegularGridInterpolator3D
from tqdm import tqdm


# ──────────────────────────────────────────────────────────────────────
#  Configuration data-class
# ──────────────────────────────────────────────────────────────────────

@dataclass
class ParticlePlotConfig:
    """All knobs for a particle-visualisation run."""

    # --- simulation data ---
    sim_dir: str = ""                 # path containing fields.h5
    mode: str = "2d"                  # "2d" | "3d_topview" | "3d_full"

    # --- iteration range ---
    it_start: int = 0
    it_end: int = -1                  # -1 → last available snapshot
    it_spacing: int = 1               # step through every N-th saved snapshot

    # --- particle seeding ---
    seed_mode: str = "tail_contour"   # "tail_contour" | "body_boundary" | "region" | "line"
    # tail_contour options
    tail_body_index: int = -1         # which body contour (-1 = last)
    tail_center_idx: int = 85         # centre index on the contour
    tail_n_particles: int = 12        # ±half-width around centre (also used for SDF tail seeding)
    # region seed
    seed_xrange: tuple[float, float] = (-0.1, 0.1)
    seed_yrange: tuple[float, float] = (-0.05, 0.05)
    seed_zrange: tuple[float, float] = (-0.05, 0.05)  # used only in 3-D
    seed_density: int = 10            # particles per axis

    # line seed
    line_start: tuple[float, ...] = (0.0, -0.05)
    line_end:   tuple[float, ...] = (0.0,  0.05)
    line_n_particles: int = 30

    # body_boundary seed options
    boundary_n_particles: int = 120   # pts sampled around body per z-layer
    boundary_n_z_layers: int = 5      # z-layers for 3-D seeding
    boundary_jitter: float = 0.002    # random offset (m) to avoid grid lock
    seed_interval: int = 10           # seed new particles every N-th solver iteration

    # --- 3-D top-view projection ---
    z_slice: Optional[float] = None   # if set, use a single z-slice instead
    z_weight: str = "uniform"         # "uniform" | "gaussian"

    # --- experimental comparison ---
    exp_dir: str = ""                 # folder with experimental dye images
    exp_pattern: str = "frame_{:06d}.png"
    exp_fps: float = 30.0             # camera frame-rate
    exp_t_offset: float = 0.0         # time offset (s) for alignment

    # --- rendering ---
    render_mode: str = "density"       # "scatter" | "density" | "both"
    density_bins: int = 300           # resolution of the density histogram
    density_sigma: float = 0        # Gaussian smoothing σ (in bins)
    density_cmap: str = "magma"       # colormap for density rendering
    density_vmax_quantile: float = 1  # clip colormap at this quantile

    # --- aesthetics ---
    particle_color: str = "#FF00A6"
    particle_size: float = 8.0
    particle_alpha: float = 0.85
    body_color: str = "#C4AF0F"
    bg_color: str = "#ffffffdc"
    bg_alpha: float = 1
    figsize: tuple[float, float] = (14, 7)
    dpi: int = 150
    xlim: Optional[tuple[float, float]] = None
    ylim: Optional[tuple[float, float]] = None
    trail_length: int = 0             # 0 = keep all history; N = last N seeds

    # --- output ---
    out_subdir: str = "particle_images"
    device: str = "cuda" if torch.cuda.is_available() else "cpu"
    dtype_str: str = "float32"

    @property
    def dtype(self) -> torch.dtype:
        return getattr(torch, self.dtype_str)


# ──────────────────────────────────────────────────────────────────────
#  HDF5 helpers
# ──────────────────────────────────────────────────────────────────────

def _sorted_iteration_keys(h5_fields_group) -> list[int]:
    """Return sorted list of iteration integers from ``fields/`` group."""
    iters = []
    for key in h5_fields_group.keys():
        try:
            iters.append(int(key))
        except ValueError:
            pass
    return sorted(iters)


def load_grids(h5path: str) -> dict[str, np.ndarray]:
    """Load grid coordinate arrays (including ghost cells) from fields.h5."""
    grids = {}
    with h5py.File(h5path, "r") as f:
        for name in f["grids"]:
            grids[name] = f[f"grids/{name}"][:]
    return grids


def load_snapshot(h5path: str, iteration: int, keys: Sequence[str] = ("u", "v")) -> dict[str, np.ndarray]:
    """Load a single snapshot from ``fields/{iteration:06d}/``."""
    data = {}
    grp = f"fields/{iteration:06d}"
    with h5py.File(h5path, "r") as f:
        for k in keys:
            ds = f"{grp}/{k}"
            if ds in f:
                data[k] = f[ds][:]
    return data


def load_contours(cnt_h5: str, iteration: int) -> list[np.ndarray] | None:
    """Load 2-D body contours from contours.h5 for a given iteration."""
    if not os.path.exists(cnt_h5):
        return None
    grp = f"{iteration:06d}"
    cnts = []
    with h5py.File(cnt_h5, "r") as f:
        if grp not in f:
            return None
        g = f[grp]
        for i in range(len(g)):
            key = f"body_{i}"
            if key in g:
                cnts.append(g[key][:])
    return cnts if cnts else None


def available_iterations(h5path: str) -> list[int]:
    """Return all iteration indices stored in fields.h5."""
    with h5py.File(h5path, "r") as f:
        if "fields" not in f:
            raise ValueError(f"No 'fields' group in {h5path}")
        return _sorted_iteration_keys(f["fields"])


def _extract_body_tail_from_sdf(
    sdf: np.ndarray,
    x: np.ndarray,
    y: np.ndarray,
    n_particles: int = 8,
    z: np.ndarray | None = None,
) -> np.ndarray:
    """Extract seed points along the trailing edge of the body from SDF.

    Finds the zero-level-set contour (body boundary) and picks points
    near the rightmost part (tail) of the body.  Works for 2-D SDF or
    3-D SDF projected along z.

    For 3-D SDF, particles are spread across multiple z-levels so
    the seeding is truly three-dimensional.

    Returns ``(2, N)`` or ``(3, N)`` array of seed positions.
    """
    from scipy import ndimage

    # For 3-D, project to x-y by taking min along z
    if sdf.ndim == 3 and z is not None:
        sdf_2d = sdf[1:-1, 1:-1, :].min(axis=2)
        xp = x[1:-1]
        yp = y[1:-1]
    elif sdf.ndim == 2:
        sdf_2d = sdf[1:-1, 1:-1]
        xp = x[1:-1]
        yp = y[1:-1]
    else:
        return np.zeros((2, 0))

    # Find boundary cells: SDF changes sign
    inside = sdf_2d <= 0
    # Dilate by 1 cell and XOR to get boundary ring
    dilated = ndimage.binary_dilation(inside, iterations=1)
    boundary = dilated & ~inside

    if not np.any(boundary):
        return np.zeros((2, 0))

    # Get x-y coords of boundary cells
    bi, bj = np.where(boundary)
    bx = xp[bi]
    by = yp[bj]

    # Pick leftmost points (tail = min x for a body swimming in +x)
    sort_idx = np.argsort(bx)  # ascending x
    n = min(n_particles, len(sort_idx))
    sel = sort_idx[:n]

    pts_xy = np.stack([bx[sel], by[sel]], axis=0)  # (2, n)

    # For 3-D: replicate at multiple z-levels spanning the BODY extent
    if sdf.ndim == 3 and z is not None:
        zp = z[1:-1]
        # Determine the z-extent of the body from the SDF (where SDF <= 0)
        body_mask_z = (sdf[1:-1, 1:-1, :] <= 0).any(axis=(0, 1))  # which z-slices have body
        if body_mask_z.any():
            z_body_indices = np.where(body_mask_z)[0]
            # sdf was not sliced in z, so indices map into full z grid
            zbody_min = float(z[z_body_indices[0]])
            zbody_max = float(z[z_body_indices[-1]])
        else:
            # Fallback: use domain center ± small range
            zbody_min = float(zp[len(zp) // 2 - 1])
            zbody_max = float(zp[len(zp) // 2 + 1])
        # Spread z-layers within the body z-extent (inset 5% so seeds are
        # just inside the body's vertical span, not at the very edge)
        dz_body = zbody_max - zbody_min
        n_z_layers = max(3, n // 2)
        z_levels = np.linspace(
            zbody_min + 0.05 * dz_body,
            zbody_max - 0.05 * dz_body,
            n_z_layers,
        )
        pts3d_list = []
        for zl in z_levels:
            z_row = np.full((1, n), zl)
            pts3d_list.append(np.vstack([pts_xy, z_row]))
        pts = np.concatenate(pts3d_list, axis=1)  # (3, n * n_z_layers)
    else:
        pts = pts_xy

    return pts


def _extract_body_boundary_from_sdf(
    sdf: np.ndarray,
    x: np.ndarray,
    y: np.ndarray,
    n_particles: int = 120,
    z: np.ndarray | None = None,
    n_z_layers: int = 5,
    jitter: float = 0.002,
) -> np.ndarray:
    """Seed particles uniformly around the *entire* body boundary from SDF.

    Unlike ``_extract_body_tail_from_sdf`` (which picks only the tail),
    this samples the full zero-level-set contour.  For 3-D fields the
    boundary points are replicated across several z-layers and a small
    random jitter is added so particles don't overlap.

    Returns ``(2, N)`` or ``(3, N)`` array of seed positions.
    """
    from scipy import ndimage

    if sdf.ndim == 3 and z is not None:
        sdf_2d = sdf[1:-1, 1:-1, :].min(axis=2)
        xp = x[1:-1]
        yp = y[1:-1]
    elif sdf.ndim == 2:
        sdf_2d = sdf[1:-1, 1:-1]
        xp = x[1:-1]
        yp = y[1:-1]
    else:
        return np.zeros((2, 0))

    inside = sdf_2d <= 0
    dilated = ndimage.binary_dilation(inside, iterations=1)
    boundary = dilated & ~inside

    if not np.any(boundary):
        return np.zeros((2, 0))

    bi, bj = np.where(boundary)
    bx = xp[bi]
    by = yp[bj]

    # Sub-sample if we have more boundary cells than requested
    if len(bx) > n_particles:
        idx = np.linspace(0, len(bx) - 1, n_particles, dtype=int)
        bx = bx[idx]
        by = by[idx]
    n = len(bx)

    pts_xy = np.stack([bx, by], axis=0)  # (2, n)

    # Add small jitter so particles from different frames don't stack
    if jitter > 0:
        pts_xy += np.random.uniform(-jitter, jitter, pts_xy.shape)

    if sdf.ndim == 3 and z is not None:
        zp = z[1:-1]
        # Determine the z-extent of the body from the SDF
        body_mask_z = (sdf[1:-1, 1:-1, :] <= 0).any(axis=(0, 1))
        if body_mask_z.any():
            z_body_idx = np.where(body_mask_z)[0]
            zbody_min = float(z[z_body_idx[0]])
            zbody_max = float(z[z_body_idx[-1]])
        else:
            zbody_min = float(zp[len(zp) // 2 - 1])
            zbody_max = float(zp[len(zp) // 2 + 1])
        dz_body = zbody_max - zbody_min
        z_levels = np.linspace(
            zbody_min + 0.05 * dz_body,
            zbody_max - 0.05 * dz_body,
            n_z_layers,
        )
        pts3d_list = []
        for zl in z_levels:
            z_row = np.full((1, n), zl)
            layer = np.vstack([pts_xy, z_row])
            if jitter > 0:
                layer[2] += np.random.uniform(-jitter, jitter, n)
            pts3d_list.append(layer)
        return np.concatenate(pts3d_list, axis=1)
    else:
        return pts_xy


# ──────────────────────────────────────────────────────────────────────
#  Particle seeding
# ──────────────────────────────────────────────────────────────────────

def seed_from_contour(
    contours: list[np.ndarray],
    body_idx: int,
    center: int,
    half_width: int,
) -> np.ndarray:
    """Seed particles from a body contour (2-D: shape ``(2, N)``)."""
    cnt = contours[body_idx]   # shape (ndim, n_pts)
    lo = max(0, center - half_width)
    hi = min(cnt.shape[1], center + half_width)
    return cnt[:, lo:hi].copy()


def seed_from_region(
    xrange: tuple[float, float],
    yrange: tuple[float, float],
    zrange: tuple[float, float] | None,
    density: int,
) -> np.ndarray:
    """Uniform grid of seed particles in a box.  Returns ``(ndim, N)``."""
    xs = np.linspace(*xrange, density)
    ys = np.linspace(*yrange, density)
    if zrange is not None:
        zs = np.linspace(*zrange, density)
        xg, yg, zg = np.meshgrid(xs, ys, zs, indexing="ij")
        return np.stack([xg.ravel(), yg.ravel(), zg.ravel()], axis=0)
    xg, yg = np.meshgrid(xs, ys, indexing="ij")
    return np.stack([xg.ravel(), yg.ravel()], axis=0)


def seed_from_line(
    start: tuple[float, ...],
    end: tuple[float, ...],
    n: int,
) -> np.ndarray:
    """Evenly-spaced particles along a line segment.  Returns ``(ndim, N)``."""
    start_a = np.array(start)
    end_a   = np.array(end)
    t = np.linspace(0.0, 1.0, n)
    pts = start_a[:, None] + (end_a - start_a)[:, None] * t[None, :]
    return pts


# ──────────────────────────────────────────────────────────────────────
#  Interpolation helpers
# ──────────────────────────────────────────────────────────────────────

def _build_interp_2d(grids, device, dtype):
    """Create u/v RegularGridInterpolator for 2-D fields."""
    x = torch.as_tensor(grids["x"], device=device, dtype=dtype)
    y = torch.as_tensor(grids["y"], device=device, dtype=dtype)
    dummy = torch.zeros(len(x), len(y), device=device, dtype=dtype)
    u_interp = RegularGridInterpolator((x, y), dummy)
    v_interp = RegularGridInterpolator((x, y), dummy)
    return x, y, u_interp, v_interp


def _build_interp_3d(grids, device, dtype):
    """Create u/v/w RegularGridInterpolator3D for 3-D fields."""
    x = torch.as_tensor(grids["x"], device=device, dtype=dtype).contiguous()
    y = torch.as_tensor(grids["y"], device=device, dtype=dtype).contiguous()
    z = torch.as_tensor(grids["z"], device=device, dtype=dtype).contiguous()
    dummy = torch.zeros(len(x), len(y), len(z), device=device, dtype=dtype).contiguous()
    u_interp = RegularGridInterpolator3D((x, y, z), dummy)
    v_interp = RegularGridInterpolator3D((x, y, z), dummy)
    w_interp = RegularGridInterpolator3D((x, y, z), dummy)
    return x, y, z, u_interp, v_interp, w_interp


# ──────────────────────────────────────────────────────────────────────
#  Advection step
# ──────────────────────────────────────────────────────────────────────

@torch.no_grad()
def advect_particles_2d(
    particles: torch.Tensor,   # (2, N)
    u_interp: RegularGridInterpolator,
    v_interp: RegularGridInterpolator,
    dt: float,
) -> torch.Tensor:
    """Forward-Euler advection of 2-D Lagrangian particles."""
    up = u_interp(particles[0], particles[1])
    vp = v_interp(particles[0], particles[1])
    particles[0].add_(up, alpha=dt)
    particles[1].add_(vp, alpha=dt)
    return particles


@torch.no_grad()
def advect_particles_3d(
    particles: torch.Tensor,   # (3, N)
    u_interp: RegularGridInterpolator,
    v_interp: RegularGridInterpolator,
    w_interp: RegularGridInterpolator,
    dt: float,
) -> torch.Tensor:
    """Forward-Euler advection of 3-D Lagrangian particles."""
    up = u_interp(particles[0], particles[1], particles[2])
    vp = v_interp(particles[0], particles[1], particles[2])
    wp = w_interp(particles[0], particles[1], particles[2])
    particles[0].add_(up, alpha=dt)
    particles[1].add_(vp, alpha=dt)
    particles[2].add_(wp, alpha=dt)
    return particles


# ──────────────────────────────────────────────────────────────────────
#  Domain-clamping & culling
# ──────────────────────────────────────────────────────────────────────

def cull_out_of_domain(particles: torch.Tensor, grids: dict) -> torch.Tensor:
    """Remove particles that have left the computational domain."""
    ndim = particles.shape[0]
    axes = ["x", "y", "z"][:ndim]
    mask = torch.ones(particles.shape[1], dtype=torch.bool, device=particles.device)
    for i, ax in enumerate(axes):
        g = grids[ax]
        lo, hi = float(g[1]), float(g[-2])  # skip ghost cells
        mask &= (particles[i] >= lo) & (particles[i] <= hi)
    return particles[:, mask]


@torch.no_grad()
def cull_inside_body(
    particles: torch.Tensor,
    sdf: np.ndarray,
    grids: dict,
    margin: float = 0.0,
) -> torch.Tensor:
    """Remove particles that are inside the body (SDF <= margin).

    Uses nearest-grid-cell lookup entirely on GPU (no CPU round-trip).
    For 3-D particles the SDF is projected along z (min over z).
    """
    if particles.shape[1] == 0:
        return particles

    device = particles.device
    dtype = particles.dtype

    xg_t = torch.as_tensor(grids["x"], device=device, dtype=dtype)
    yg_t = torch.as_tensor(grids["y"], device=device, dtype=dtype)

    # Project 3-D SDF to 2-D if needed
    if sdf.ndim == 3:
        sdf_2d = sdf.min(axis=2)
    else:
        sdf_2d = sdf

    sdf_t = torch.as_tensor(np.ascontiguousarray(sdf_2d), device=device, dtype=dtype)

    # Nearest-cell indices on GPU
    ix = torch.searchsorted(xg_t, particles[0].contiguous()).clamp(0, xg_t.shape[0] - 1)
    iy = torch.searchsorted(yg_t, particles[1].contiguous()).clamp(0, yg_t.shape[0] - 1)

    sdf_vals = sdf_t[ix, iy]
    outside = sdf_vals > margin
    return particles[:, outside]


# ──────────────────────────────────────────────────────────────────────
#  Drawing helpers
# ──────────────────────────────────────────────────────────────────────

def _draw_body_sdf_topview(
    ax: plt.Axes,
    sdf: np.ndarray,
    x: np.ndarray,
    y: np.ndarray,
    z: np.ndarray | None = None,
    color: str = "#FFEA00",
    outline_color: str = "#000000",
    outline_width: float = 1.5,
):
    """Draw body interior (sdf <= 0) as a filled region with outline.

    For 3-D, projects by taking the minimum SDF along z (body visible
    from top whenever *any* z-slice contains solid).
    """
    if sdf.ndim == 3 and z is not None:
        sdf_2d = sdf.min(axis=2)  # project along z
    elif sdf.ndim == 2:
        sdf_2d = sdf
    else:
        return

    # strip ghost cells
    s = slice(1, -1)
    sdf_2d = sdf_2d[s, s]
    xp = x[s]
    yp = y[s]

    # Filled body
    ax.contourf(
        xp, yp, sdf_2d.T,
        levels=[-1e10, 0.0],
        colors=[color],
        zorder=2,
    )
    # Black outline
    ax.contour(
        xp, yp, sdf_2d.T,
        levels=[0.0],
        colors=[outline_color],
        linewidths=[outline_width],
        zorder=2,
    )


def _draw_contours_2d(ax: plt.Axes, contours: list[np.ndarray], color: str = "#FFEA00",
                      outline_color: str = "#000000", outline_width: float = 1.5):
    """Draw filled body contours on a 2-D axis with outline."""
    for cnt in contours:
        ax.fill(cnt[0], cnt[1], color=color, zorder=2)
        ax.plot(cnt[0], cnt[1], color=outline_color, linewidth=outline_width, zorder=2)


def _draw_dye_density(
    ax: plt.Axes,
    px: np.ndarray,
    py: np.ndarray,
    xlim: tuple[float, float],
    ylim: tuple[float, float],
    bins: int = 300,
    sigma: float = 1.5,
    cmap: str = "magma",
    vmax_quantile: float = 0.98,
    zorder: int = 1,
):
    """Render particles as a Gaussian-smoothed density field (dye look).

    Produces a soft, smoke-like visualisation similar to experimental
    fluorescent-dye images taken from an overhead camera.
    """
    if len(px) == 0:
        return

    H, xedges, yedges = np.histogram2d(
        px, py, bins=bins,
        range=[list(xlim), list(ylim)],
    )
    H = H.astype(np.float64)
    # Smooth to get the "smoke" look (skip if sigma <= 0)
    if sigma > 0:
        from scipy.ndimage import gaussian_filter
        H = gaussian_filter(H, sigma=sigma)

    # Normalise
    if H.max() > 0:
        H /= H.max()

    # Clip to avoid a few bright outliers dominating the colormap
    vmax = np.quantile(H[H > 0], vmax_quantile) if np.any(H > 0) else 1.0
    vmax = max(vmax, 1e-8)

    # Build RGBA image: fixed pink colour, alpha proportional to density
    pink = np.array([1.0, 0.41, 0.71])          # hot-pink RGB
    alpha = np.clip(H.T / vmax, 0.0, 1.0)       # 0 → transparent, 1 → opaque
    # alpha = alpha ** 0.4                          # gamma < 1 → boost mid-tones
    rgba = np.zeros((*alpha.shape, 4))
    rgba[..., :3] = pink
    rgba[..., 3] = 3*alpha

    ax.imshow(
        rgba,
        origin="lower",
        extent=[xedges[0], xedges[-1], yedges[0], yedges[-1]],
        aspect="auto",
        interpolation="bilinear",
        zorder=zorder,
    )


def _load_exp_frame(exp_dir: str, pattern: str, index: int) -> np.ndarray | None:
    """Load an experimental camera frame as an RGBA / RGB numpy array."""
    path = os.path.join(exp_dir, pattern.format(index))
    if not os.path.isfile(path):
        # Try globbing with wildcard for flexibility
        candidates = sorted(glob.glob(os.path.join(exp_dir, "*")))
        if index < len(candidates):
            path = candidates[index]
        else:
            return None
    return plt.imread(path)


# ──────────────────────────────────────────────────────────────────────
#  Main plotting routines
# ──────────────────────────────────────────────────────────────────────

def _compute_dt_between_snapshots(iters: list[int], idx: int, base_dt: float) -> float:
    """Physical time elapsed between consecutive stored snapshots."""
    if idx + 1 < len(iters):
        return (iters[idx + 1] - iters[idx]) * base_dt
    if idx > 0:
        return (iters[idx] - iters[idx - 1]) * base_dt
    return base_dt


def run_2d(cfg: ParticlePlotConfig):
    """2-D particle advection and rendering."""
    fields_h5 = os.path.join(cfg.sim_dir, "fields.h5")
    contours_h5 = os.path.join(cfg.sim_dir, "contours.h5")
    grids = load_grids(fields_h5)
    iters = available_iterations(fields_h5)

    # Infer timestep from iteration spacing (assumes uniform dt)
    if len(iters) >= 2:
        base_dt = 1.0  # will cancel — we use snapshot-to-snapshot
    else:
        base_dt = 1.0

    # Resolve iteration range
    it_start = cfg.it_start
    it_end = cfg.it_end if cfg.it_end > 0 else iters[-1]
    sel = [it for it in iters if it_start <= it <= it_end][:: cfg.it_spacing]

    device = torch.device(cfg.device)
    dtype  = cfg.dtype
    x, y, u_interp, v_interp = _build_interp_2d(grids, device, dtype)

    # Domain limits for plotting (physical cells, no ghost)
    xmin, xmax = float(x[1]), float(x[-2])
    ymin, ymax = float(y[1]), float(y[-2])
    xlim = cfg.xlim or (xmin, xmax)
    ylim = cfg.ylim or (ymin, ymax)

    particles = torch.zeros((2, 0), device=device, dtype=dtype)
    img_dir = os.path.join(cfg.sim_dir, cfg.out_subdir)
    os.makedirs(img_dir, exist_ok=True)

    has_exp = cfg.exp_dir and os.path.isdir(cfg.exp_dir)

    for frame_idx, it in enumerate(tqdm(sel, desc="2-D particles")):
        snap = load_snapshot(fields_h5, it, keys=("u", "v", "sdf"))
        u_t = torch.as_tensor(snap["u"], device=device, dtype=dtype)
        v_t = torch.as_tensor(snap["v"], device=device, dtype=dtype)
        u_interp.F = u_t
        v_interp.F = v_t

        # Seed new particles
        cnts = load_contours(contours_h5, it)
        if cfg.seed_mode == "body_boundary":
            if "sdf" in snap:
                new_pts = _extract_body_boundary_from_sdf(
                    snap["sdf"], grids["x"], grids["y"],
                    n_particles=cfg.boundary_n_particles,
                    jitter=cfg.boundary_jitter,
                )
                if new_pts.shape[1] > 0:
                    new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                    particles = torch.cat([particles, new_pts_t], dim=1)
        elif cfg.seed_mode == "tail_contour" and cnts is not None:
            new_pts = seed_from_contour(cnts, cfg.tail_body_index, cfg.tail_center_idx, cfg.tail_n_particles)
            new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
            particles = torch.cat([particles, new_pts_t], dim=1)
        elif cfg.seed_mode == "region" and frame_idx == 0:
            new_pts = seed_from_region(cfg.seed_xrange, cfg.seed_yrange, None, cfg.seed_density)
            particles = torch.as_tensor(new_pts, device=device, dtype=dtype)
        elif cfg.seed_mode == "line" and frame_idx == 0:
            new_pts = seed_from_line(cfg.line_start, cfg.line_end, cfg.line_n_particles)
            particles = torch.as_tensor(new_pts, device=device, dtype=dtype)

        # Trail length trimming
        if cfg.trail_length > 0:
            max_pts = cfg.trail_length * cfg.tail_n_particles * 2
            if particles.shape[1] > max_pts:
                particles = particles[:, -max_pts:]

        # Remove particles trapped inside the body
        if "sdf" in snap and particles.shape[1] > 0:
            particles = cull_inside_body(particles, snap["sdf"], grids)

        # ---- Draw ----
        n_cols = 2 if has_exp else 1
        fig, axes = plt.subplots(1, n_cols, figsize=cfg.figsize, dpi=cfg.dpi)
        fig.patch.set_facecolor(cfg.bg_color)
        fig.patch.set_alpha(cfg.bg_alpha)
        if n_cols == 1:
            axes = [axes]

        ax_sim = axes[0]
        ax_sim.set_facecolor(cfg.bg_color)
        ax_sim.patch.set_alpha(cfg.bg_alpha)

        # Body
        if "sdf" in snap:
            _draw_body_sdf_topview(ax_sim, snap["sdf"], grids["x"], grids["y"], color=cfg.body_color)
        elif cnts is not None:
            _draw_contours_2d(ax_sim, cnts, color=cfg.body_color)

        # Particles
        if particles.shape[1] > 0:
            px_np = particles[0].cpu().numpy()
            py_np = particles[1].cpu().numpy()
            if cfg.render_mode in ("density", "both"):
                _draw_dye_density(
                    ax_sim, px_np, py_np, xlim, ylim,
                    bins=cfg.density_bins, sigma=cfg.density_sigma,
                    cmap=cfg.density_cmap, vmax_quantile=cfg.density_vmax_quantile,
                    zorder=1,
                )
            if cfg.render_mode in ("scatter", "both"):
                ax_sim.scatter(
                    px_np, py_np,
                    c=cfg.particle_color, s=cfg.particle_size,
                    alpha=cfg.particle_alpha, edgecolors="none", zorder=3,
                )

        ax_sim.set_xlim(xlim)
        ax_sim.set_ylim(ylim)
        ax_sim.set_aspect("equal")
        ax_sim.set_title(f"Simulation  —  iter {it}", fontsize=12)
        ax_sim.set_xlabel("x [m]")
        ax_sim.set_ylabel("y [m]")

        # Experimental frame
        if has_exp:
            ax_exp = axes[1]
            exp_frame = _load_exp_frame(cfg.exp_dir, cfg.exp_pattern, frame_idx)
            if exp_frame is not None:
                ax_exp.imshow(exp_frame, origin="upper")
                ax_exp.set_title("Experiment (top view)", fontsize=12)
            ax_exp.axis("off")

        fig.tight_layout()
        fig.savefig(os.path.join(img_dir, f"particles_{it:06d}.png"), dpi=cfg.dpi,
                    facecolor=fig.get_facecolor(), edgecolor="none")
        plt.close(fig)

        # Sub-stepped advection + continuous dye seeding to next snapshot
        if frame_idx + 1 < len(sel) and particles.shape[1] > 0:
            next_it = sel[frame_idx + 1]
            solver_dt = _infer_dt(fields_h5, iters)
            n_solver_iters = next_it - it  # actual solver iterations between saves

            # Pre-convert velocities to torch (blend via torch.lerp, no numpy→torch per step)
            next_snap_2d = load_snapshot(fields_h5, next_it, keys=("u", "v", "sdf"))
            u_curr_t = torch.as_tensor(snap["u"], device=device, dtype=dtype)
            v_curr_t = torch.as_tensor(snap["v"], device=device, dtype=dtype)
            u_next_t = torch.as_tensor(next_snap_2d["u"], device=device, dtype=dtype)
            v_next_t = torch.as_tensor(next_snap_2d["v"], device=device, dtype=dtype)

            # Pre-compute seed templates at BOTH endpoints and lerp positions
            seed_curr_t = None
            seed_next_t = None
            if cfg.seed_mode in ("tail_contour", "body_boundary") and "sdf" in snap:
                if cfg.seed_mode == "body_boundary":
                    seed_curr = _extract_body_boundary_from_sdf(
                        snap["sdf"], grids["x"], grids["y"],
                        n_particles=cfg.boundary_n_particles,
                        jitter=0,
                    )
                    seed_next = _extract_body_boundary_from_sdf(
                        next_snap_2d.get("sdf", snap["sdf"]), grids["x"], grids["y"],
                        n_particles=cfg.boundary_n_particles,
                        jitter=0,
                    ) if "sdf" in next_snap_2d else seed_curr
                else:
                    seed_curr = _extract_body_tail_from_sdf(
                        snap["sdf"], grids["x"], grids["y"],
                        n_particles=cfg.tail_n_particles * 2,
                    )
                    seed_next = _extract_body_tail_from_sdf(
                        next_snap_2d.get("sdf", snap["sdf"]), grids["x"], grids["y"],
                        n_particles=cfg.tail_n_particles * 2,
                    ) if "sdf" in next_snap_2d else seed_curr
                # Ensure both have same number of points (truncate to min)
                n_common = min(seed_curr.shape[1], seed_next.shape[1])
                if n_common > 0:
                    seed_curr_t = torch.as_tensor(seed_curr[:, :n_common], device=device, dtype=dtype)
                    seed_next_t = torch.as_tensor(seed_next[:, :n_common], device=device, dtype=dtype)

            si = max(1, cfg.seed_interval)
            cull_every = max(1, min(50, n_solver_iters // 4))

            # Pre-allocate lerp buffers to avoid per-step allocations
            u_buf = torch.empty_like(u_curr_t)
            v_buf = torch.empty_like(v_curr_t)

            with torch.no_grad():
                for k in range(n_solver_iters):
                    alpha = (k + 1) / n_solver_iters
                    torch.lerp(u_curr_t, u_next_t, alpha, out=u_buf)
                    torch.lerp(v_curr_t, v_next_t, alpha, out=v_buf)
                    u_interp.F = u_buf
                    v_interp.F = v_buf

                    # Seed at interpolated body position
                    if seed_curr_t is not None and k % si == 0:
                        seed_pos = torch.lerp(seed_curr_t, seed_next_t, alpha)
                        jitter = torch.empty_like(seed_pos).uniform_(-0.001, 0.001)
                        particles = torch.cat([particles, seed_pos + jitter], dim=1)

                    particles = advect_particles_2d(particles, u_interp, v_interp, solver_dt)

                    if k % cull_every == 0:
                        particles = cull_out_of_domain(particles, grids)

            particles = cull_out_of_domain(particles, grids)

    print(f"[2-D] Saved {len(sel)} frames to {img_dir}")


def run_3d_topview(cfg: ParticlePlotConfig):
    """3-D particle advection with top-view (x-y) projection.

    This is the mode most directly comparable to an overhead camera
    filming dye released around a swimming robot.  Particles are advected
    in full 3-D but rendered by projecting onto the x-y plane (i.e. the
    camera looks straight down along −z).
    """
    fields_h5 = os.path.join(cfg.sim_dir, "fields.h5")
    contours_h5 = os.path.join(cfg.sim_dir, "contours.h5")
    grids = load_grids(fields_h5)
    iters = available_iterations(fields_h5)

    is_3d = "z" in grids
    if not is_3d:
        print("[WARN] Data is 2-D — falling back to 2-D mode.")
        return run_2d(cfg)

    it_start = cfg.it_start
    it_end = cfg.it_end if cfg.it_end > 0 else iters[-1]
    sel = [it for it in iters if it_start <= it <= it_end][:: cfg.it_spacing]

    device = torch.device(cfg.device)
    dtype  = cfg.dtype
    x, y, z, u_interp, v_interp, w_interp = _build_interp_3d(grids, device, dtype)

    xmin, xmax = float(x[1]), float(x[-2])
    ymin, ymax = float(y[1]), float(y[-2])
    zmin, zmax = float(z[1]), float(z[-2])
    zmid = 0.5 * (zmin + zmax)
    xlim = cfg.xlim or (xmin, xmax)
    ylim = cfg.ylim or (ymin, ymax)

    particles = torch.zeros((3, 0), device=device, dtype=dtype)
    img_dir = os.path.join(cfg.sim_dir, cfg.out_subdir)
    os.makedirs(img_dir, exist_ok=True)

    has_exp = cfg.exp_dir and os.path.isdir(cfg.exp_dir)

    for frame_idx, it in enumerate(tqdm(sel, desc="3-D top-view particles")):
        snap = load_snapshot(fields_h5, it, keys=("u", "v", "w", "sdf"))
        u_interp.F = torch.as_tensor(snap["u"], device=device, dtype=dtype).contiguous()
        v_interp.F = torch.as_tensor(snap["v"], device=device, dtype=dtype).contiguous()
        if "w" in snap:
            w_interp.F = torch.as_tensor(snap["w"], device=device, dtype=dtype).contiguous()

        # Seed particles
        if cfg.seed_mode == "region":
            if frame_idx == 0:
                new_pts = seed_from_region(cfg.seed_xrange, cfg.seed_yrange, cfg.seed_zrange, cfg.seed_density)
                particles = torch.as_tensor(new_pts, device=device, dtype=dtype)
        elif cfg.seed_mode == "line":
            if frame_idx == 0:
                # Extend 2-D line to 3-D at z=zmid
                start_3d = (*cfg.line_start[:2], zmid)
                end_3d   = (*cfg.line_end[:2],   zmid)
                new_pts = seed_from_line(start_3d, end_3d, cfg.line_n_particles)
                particles = torch.as_tensor(new_pts, device=device, dtype=dtype)
        elif cfg.seed_mode == "body_boundary":
            # Seed around the entire body boundary (dye-coating mode)
            if "sdf" in snap:
                new_pts = _extract_body_boundary_from_sdf(
                    snap["sdf"], grids["x"], grids["y"],
                    n_particles=cfg.boundary_n_particles,
                    z=grids.get("z"),
                    n_z_layers=cfg.boundary_n_z_layers,
                    jitter=cfg.boundary_jitter,
                )
                if new_pts.shape[1] > 0:
                    new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                    particles = torch.cat([particles, new_pts_t], dim=1)
        elif cfg.seed_mode == "tail_contour":
            # For 3-D: try contours.h5 first, fall back to SDF extraction
            cnts = load_contours(contours_h5, it)
            if cnts is not None:
                pts2d = seed_from_contour(cnts, cfg.tail_body_index, cfg.tail_center_idx, cfg.tail_n_particles)
                # Expand to 3-D: replicate at z-levels spanning the BODY extent
                n_z_layers = 3
                # Determine body z-extent from SDF
                if "sdf" in snap and snap["sdf"].ndim == 3:
                    body_mask_z = (snap["sdf"][1:-1, 1:-1, :] <= 0).any(axis=(0, 1))
                    if body_mask_z.any():
                        z_body_idx = np.where(body_mask_z)[0]
                        zbody_lo = float(grids["z"][z_body_idx[0]])
                        zbody_hi = float(grids["z"][z_body_idx[-1]])
                    else:
                        zbody_lo, zbody_hi = zmid - 0.01, zmid + 0.01
                else:
                    zbody_lo, zbody_hi = zmid - 0.01, zmid + 0.01
                dz_body = zbody_hi - zbody_lo
                z_levels = np.linspace(
                    zbody_lo + 0.05 * dz_body,
                    zbody_hi - 0.05 * dz_body,
                    n_z_layers,
                )
                pts3d_list = []
                for zl in z_levels:
                    z_row = np.full((1, pts2d.shape[1]), zl)
                    pts3d_list.append(np.vstack([pts2d, z_row]))
                new_pts = np.concatenate(pts3d_list, axis=1)
                new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                particles = torch.cat([particles, new_pts_t], dim=1)
            elif "sdf" in snap:
                # No contours file (typical for 3-D) — seed from SDF boundary
                new_pts = _extract_body_tail_from_sdf(
                    snap["sdf"], grids["x"], grids["y"],
                    n_particles=cfg.tail_n_particles * 2,
                    z=grids.get("z"),
                )
                if new_pts.shape[1] > 0:
                    new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                    particles = torch.cat([particles, new_pts_t], dim=1)

        if cfg.trail_length > 0:
            max_pts = cfg.trail_length * max(cfg.tail_n_particles * 2 * 3, cfg.seed_density ** 3)
            if particles.shape[1] > max_pts:
                particles = particles[:, -max_pts:]

        # Remove particles trapped inside the body
        if "sdf" in snap and particles.shape[1] > 0:
            particles = cull_inside_body(particles, snap["sdf"], grids)

        # ---- Draw (top-view = x-y projection) ----
        n_cols = 2 if has_exp else 1
        fig, axes = plt.subplots(1, n_cols, figsize=cfg.figsize, dpi=cfg.dpi)
        fig.patch.set_facecolor(cfg.bg_color)
        fig.patch.set_alpha(cfg.bg_alpha)
        if n_cols == 1:
            axes = [axes]

        ax_sim = axes[0]
        ax_sim.set_facecolor(cfg.bg_color)
        ax_sim.patch.set_alpha(cfg.bg_alpha)

        # Body (top-view projection via min-SDF along z)
        if "sdf" in snap:
            _draw_body_sdf_topview(
                ax_sim, snap["sdf"],
                grids["x"], grids["y"], grids.get("z"),
                color=cfg.body_color,
            )

        # Particles — project (x, y) ignoring z
        if particles.shape[1] > 0:
            px = particles[0].cpu().numpy()
            py = particles[1].cpu().numpy()
            if cfg.render_mode in ("density", "both"):
                _draw_dye_density(
                    ax_sim, px, py, xlim, ylim,
                    bins=cfg.density_bins, sigma=cfg.density_sigma,
                    cmap=cfg.density_cmap, vmax_quantile=cfg.density_vmax_quantile,
                    zorder=1,
                )
            if cfg.render_mode in ("scatter", "both"):
                ax_sim.scatter(
                    px, py,
                    c=cfg.particle_color, s=cfg.particle_size,
                    alpha=cfg.particle_alpha, edgecolors="none", zorder=3,
                )

        ax_sim.set_xlim(xlim)
        ax_sim.set_ylim(ylim)
        ax_sim.set_aspect("equal")
        ax_sim.set_title(f"Simulation (top view)  —  iter {it}", fontsize=12)
        ax_sim.set_xlabel("x [m]")
        ax_sim.set_ylabel("y [m]")

        # Experimental frame
        if has_exp:
            ax_exp = axes[1]
            exp_frame = _load_exp_frame(cfg.exp_dir, cfg.exp_pattern, frame_idx)
            if exp_frame is not None:
                ax_exp.imshow(exp_frame, origin="upper")
                ax_exp.set_title("Experiment (top view)", fontsize=12)
            ax_exp.axis("off")

        fig.tight_layout()
        fig.savefig(os.path.join(img_dir, f"particles_topview_{it:06d}.png"), dpi=cfg.dpi,
                    facecolor=fig.get_facecolor(), edgecolor="none")
        plt.close(fig)

        # Sub-stepped advection + continuous dye seeding to next snapshot
        if frame_idx + 1 < len(sel) and particles.shape[1] > 0:
            next_it = sel[frame_idx + 1]
            solver_dt = _infer_dt(fields_h5, iters)
            n_solver_iters = next_it - it  # actual solver iterations between saves

            # Pre-convert velocities to torch (blend via torch.lerp, no numpy→torch per step)
            next_snap = load_snapshot(fields_h5, next_it, keys=("u", "v", "w", "sdf"))
            u_curr_t = torch.as_tensor(snap["u"], device=device, dtype=dtype).contiguous()
            v_curr_t = torch.as_tensor(snap["v"], device=device, dtype=dtype).contiguous()
            u_next_t = torch.as_tensor(next_snap["u"], device=device, dtype=dtype).contiguous()
            v_next_t = torch.as_tensor(next_snap["v"], device=device, dtype=dtype).contiguous()
            w_curr_t = torch.as_tensor(snap["w"], device=device, dtype=dtype).contiguous() if "w" in snap else None
            w_next_t = torch.as_tensor(next_snap["w"], device=device, dtype=dtype).contiguous() if "w" in next_snap else None

            # Pre-compute seed templates at BOTH endpoints and lerp positions
            seed_curr_t = None
            seed_next_t = None
            if cfg.seed_mode in ("tail_contour", "body_boundary") and "sdf" in snap:
                if cfg.seed_mode == "body_boundary":
                    seed_curr = _extract_body_boundary_from_sdf(
                        snap["sdf"], grids["x"], grids["y"],
                        n_particles=cfg.boundary_n_particles,
                        z=grids.get("z"),
                        n_z_layers=cfg.boundary_n_z_layers,
                        jitter=0,
                    )
                    seed_next = _extract_body_boundary_from_sdf(
                        next_snap.get("sdf", snap["sdf"]), grids["x"], grids["y"],
                        n_particles=cfg.boundary_n_particles,
                        z=grids.get("z"),
                        n_z_layers=cfg.boundary_n_z_layers,
                        jitter=0,
                    ) if "sdf" in next_snap else seed_curr
                else:
                    seed_curr = _extract_body_tail_from_sdf(
                        snap["sdf"], grids["x"], grids["y"],
                        n_particles=cfg.tail_n_particles * 2,
                        z=grids.get("z"),
                    )
                    seed_next = _extract_body_tail_from_sdf(
                        next_snap.get("sdf", snap["sdf"]), grids["x"], grids["y"],
                        n_particles=cfg.tail_n_particles * 2,
                        z=grids.get("z"),
                    ) if "sdf" in next_snap else seed_curr
                # Ensure both have same number of points (truncate to min)
                n_common = min(seed_curr.shape[1], seed_next.shape[1])
                if n_common > 0:
                    seed_curr_t = torch.as_tensor(seed_curr[:, :n_common], device=device, dtype=dtype)
                    seed_next_t = torch.as_tensor(seed_next[:, :n_common], device=device, dtype=dtype)

            si = max(1, cfg.seed_interval)
            cull_every = max(1, min(50, n_solver_iters // 4))

            # Pre-allocate lerp buffers to avoid per-step allocations
            u_buf = torch.empty_like(u_curr_t)
            v_buf = torch.empty_like(v_curr_t)
            w_buf = torch.empty_like(w_curr_t) if w_curr_t is not None else None

            with torch.no_grad():
                for k in range(n_solver_iters):
                    alpha = (k + 1) / n_solver_iters
                    # Blend in-place into pre-allocated buffers
                    torch.lerp(u_curr_t, u_next_t, alpha, out=u_buf)
                    torch.lerp(v_curr_t, v_next_t, alpha, out=v_buf)
                    u_interp.F = u_buf
                    v_interp.F = v_buf
                    if w_buf is not None and w_next_t is not None:
                        torch.lerp(w_curr_t, w_next_t, alpha, out=w_buf)
                        w_interp.F = w_buf

                    # Seed at interpolated body position
                    if seed_curr_t is not None and k % si == 0:
                        seed_pos = torch.lerp(seed_curr_t, seed_next_t, alpha)
                        jitter = torch.empty_like(seed_pos).uniform_(-0.001, 0.001)
                        particles = torch.cat([particles, seed_pos + jitter], dim=1)

                    particles = advect_particles_3d(particles, u_interp, v_interp, w_interp, solver_dt)

                    if k % cull_every == 0:
                        particles = cull_out_of_domain(particles, grids)

            particles = cull_out_of_domain(particles, grids)

    print(f"[3-D top-view] Saved {len(sel)} frames to {img_dir}")


def run_3d_full(cfg: ParticlePlotConfig):
    """Full 3-D rendering using matplotlib's 3-D scatter.

    Less common than the top-view but useful for inspecting the vertical
    structure of the wake.
    """
    fields_h5 = os.path.join(cfg.sim_dir, "fields.h5")
    contours_h5 = os.path.join(cfg.sim_dir, "contours.h5")
    grids = load_grids(fields_h5)
    iters = available_iterations(fields_h5)

    is_3d = "z" in grids
    if not is_3d:
        print("[WARN] Data is 2-D — falling back to 2-D mode.")
        return run_2d(cfg)

    it_start = cfg.it_start
    it_end = cfg.it_end if cfg.it_end > 0 else iters[-1]
    sel = [it for it in iters if it_start <= it <= it_end][:: cfg.it_spacing]

    device = torch.device(cfg.device)
    dtype  = cfg.dtype
    x, y, z, u_interp, v_interp, w_interp = _build_interp_3d(grids, device, dtype)

    xmin, xmax = float(x[1]), float(x[-2])
    ymin, ymax = float(y[1]), float(y[-2])
    zmin, zmax = float(z[1]), float(z[-2])
    zmid = 0.5 * (zmin + zmax)

    particles = torch.zeros((3, 0), device=device, dtype=dtype)
    img_dir = os.path.join(cfg.sim_dir, cfg.out_subdir)
    os.makedirs(img_dir, exist_ok=True)

    for frame_idx, it in enumerate(tqdm(sel, desc="3-D full particles")):
        snap = load_snapshot(fields_h5, it, keys=("u", "v", "w", "sdf"))
        u_interp.F = torch.as_tensor(snap["u"], device=device, dtype=dtype).contiguous()
        v_interp.F = torch.as_tensor(snap["v"], device=device, dtype=dtype).contiguous()
        if "w" in snap:
            w_interp.F = torch.as_tensor(snap["w"], device=device, dtype=dtype).contiguous()

        # Seed particles (same logic as top-view)
        if cfg.seed_mode == "region" and frame_idx == 0:
            new_pts = seed_from_region(cfg.seed_xrange, cfg.seed_yrange, cfg.seed_zrange, cfg.seed_density)
            particles = torch.as_tensor(new_pts, device=device, dtype=dtype)
        elif cfg.seed_mode == "line" and frame_idx == 0:
            start_3d = (*cfg.line_start[:2], zmid)
            end_3d   = (*cfg.line_end[:2],   zmid)
            new_pts = seed_from_line(start_3d, end_3d, cfg.line_n_particles)
            particles = torch.as_tensor(new_pts, device=device, dtype=dtype)
        elif cfg.seed_mode == "tail_contour":
            cnts = load_contours(contours_h5, it)
            if cnts is not None:
                pts2d = seed_from_contour(cnts, cfg.tail_body_index, cfg.tail_center_idx, cfg.tail_n_particles)
                z_row = np.full((1, pts2d.shape[1]), zmid)
                new_pts = np.vstack([pts2d, z_row])
                new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                particles = torch.cat([particles, new_pts_t], dim=1)
            elif "sdf" in snap:
                new_pts = _extract_body_tail_from_sdf(
                    snap["sdf"], grids["x"], grids["y"],
                    n_particles=cfg.tail_n_particles * 2,
                    z=grids.get("z"),
                )
                if new_pts.shape[1] > 0:
                    new_pts_t = torch.as_tensor(new_pts, device=device, dtype=dtype)
                    particles = torch.cat([particles, new_pts_t], dim=1)

        # ---- Draw 3-D scatter ----
        fig = plt.figure(figsize=cfg.figsize, dpi=cfg.dpi)
        fig.patch.set_facecolor(cfg.bg_color)
        fig.patch.set_alpha(cfg.bg_alpha)
        ax = fig.add_subplot(111, projection="3d")
        ax.set_facecolor(cfg.bg_color)

        if particles.shape[1] > 0:
            px = particles[0].cpu().numpy()
            py = particles[1].cpu().numpy()
            pz = particles[2].cpu().numpy()
            ax.scatter(
                px, py, pz,
                c=cfg.particle_color, s=cfg.particle_size,
                alpha=cfg.particle_alpha, depthshade=True,
            )

        # Body iso-surface (simple: contour at sdf=0 on mid-z slice)
        if "sdf" in snap:
            sdf = snap["sdf"]
            nz = sdf.shape[2]
            mid_z = nz // 2
            sdf_mid = sdf[1:-1, 1:-1, mid_z]
            xp = grids["x"][1:-1]
            yp = grids["y"][1:-1]
            try:
                ax.contour(
                    xp, yp, sdf_mid.T, levels=[0.0],
                    colors=[cfg.body_color], linewidths=2,
                    zdir="z", offset=float(grids["z"][mid_z]),
                )
            except Exception:
                pass

        ax.set_xlim(cfg.xlim or (xmin, xmax))
        ax.set_ylim(cfg.ylim or (ymin, ymax))
        ax.set_zlim(zmin, zmax)
        ax.set_xlabel("x")
        ax.set_ylabel("y")
        ax.set_zlabel("z")
        ax.set_title(f"3-D particles — iter {it}", fontsize=12)
        ax.view_init(elev=25, azim=-60)

        fig.tight_layout()
        fig.savefig(os.path.join(img_dir, f"particles_3d_{it:06d}.png"), dpi=cfg.dpi,
                    facecolor=fig.get_facecolor(), edgecolor="none")
        plt.close(fig)

        # Advect
        if frame_idx + 1 < len(sel) and particles.shape[1] > 0:
            dt_snap = (sel[frame_idx + 1] - it) * _infer_dt(fields_h5, iters)
            particles = advect_particles_3d(particles, u_interp, v_interp, w_interp, dt_snap)
            particles = cull_out_of_domain(particles, grids)

    print(f"[3-D full] Saved {len(sel)} frames to {img_dir}")


# ──────────────────────────────────────────────────────────────────────
#  Timestep inference
# ──────────────────────────────────────────────────────────────────────

def _infer_dt(fields_h5: str, iters: list[int] | None = None) -> float:
    """Attempt to infer the solver timestep from metadata or from the
    simulation config YAML adjacent to the run folder.

    Falls back to ``dt = 0.001`` if nothing else can be found.
    """
    sim_dir = os.path.dirname(fields_h5)

    # Try reading from parameters.yaml (saved by lilytorch alongside fields.h5)
    # This file uses custom YAML tags that yaml.safe_load can't handle,
    # so we do a simple regex search for the 'dt:' line.
    params_path = os.path.join(sim_dir, "parameters.yaml")
    if os.path.isfile(params_path):
        try:
            import re as _re
            with open(params_path) as fh:
                for line in fh:
                    m = _re.match(r"\s*dt:\s*([\d.eE+\-]+)", line)
                    if m:
                        return float(m.group(1))
        except Exception:
            pass

    # Try reading from other YAML configs stored alongside the data
    for name in ("config.yaml", "config.yml", "bdim_config.yaml"):
        ypath = os.path.join(sim_dir, name)
        if os.path.isfile(ypath):
            try:
                import yaml
                with open(ypath) as fh:
                    cfg = yaml.safe_load(fh)
                dt = cfg.get("solver", {}).get("dt", None)
                if dt is not None:
                    return float(dt)
            except Exception:
                pass

    # Try from HDF5 attributes
    try:
        with h5py.File(fields_h5, "r") as f:
            if "dt" in f.attrs:
                return float(f.attrs["dt"])
    except Exception:
        pass

    # Default fallback
    print("[WARN] Could not infer dt — using default 0.001")
    return 0.001


# ──────────────────────────────────────────────────────────────────────
#  CLI
# ──────────────────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Lagrangian particle visualisation from lilytorch HDF5 data.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    p.add_argument("--sim_dir", type=str, required=True,
                   help="Path to simulation output containing fields.h5.")
    p.add_argument("--mode", type=str, default="2d",
                   choices=["2d", "3d_topview", "3d_full"],
                   help="Visualisation mode.")

    g = p.add_argument_group("Iteration range")
    g.add_argument("--it_start", type=int, default=0)
    g.add_argument("--it_end",   type=int, default=-1,
                   help="-1 = last available snapshot.")
    g.add_argument("--it_spacing", type=int, default=1,
                   help="Use every N-th saved snapshot.")

    g = p.add_argument_group("Particle seeding")
    g.add_argument("--seed_mode", type=str, default="tail_contour",
                   choices=["tail_contour", "body_boundary", "region", "line"])
    g.add_argument("--boundary_n_particles", type=int, default=120,
                   help="Points sampled around body per z-layer (body_boundary mode).")
    g.add_argument("--boundary_n_z_layers", type=int, default=5,
                   help="Number of z-layers for 3-D body_boundary seeding.")
    g.add_argument("--boundary_jitter", type=float, default=0.002,
                   help="Random offset (m) added to boundary seeds.")
    g.add_argument("--tail_body_index", type=int, default=-1)
    g.add_argument("--tail_center_idx", type=int, default=85)
    g.add_argument("--tail_n_particles", type=int, default=12)
    g.add_argument("--seed_interval", type=int, default=10,
                   help="Seed new particles every N-th solver iteration between saves.")
    g.add_argument("--seed_xrange", type=float, nargs=2, default=[-0.1, 0.1])
    g.add_argument("--seed_yrange", type=float, nargs=2, default=[-0.05, 0.05])
    g.add_argument("--seed_zrange", type=float, nargs=2, default=[-0.05, 0.05])
    g.add_argument("--seed_density", type=int, default=10)
    g.add_argument("--line_start", type=float, nargs="+", default=[0.0, -0.05])
    g.add_argument("--line_end",   type=float, nargs="+", default=[0.0, 0.05])
    g.add_argument("--line_n_particles", type=int, default=30)

    g = p.add_argument_group("Experimental comparison")
    g.add_argument("--exp_dir", type=str, default="",
                   help="Folder with experimental dye images (top-view camera).")
    g.add_argument("--exp_pattern", type=str, default="frame_{:06d}.png",
                   help="Python format-string for experimental frame filename.")
    g.add_argument("--exp_fps", type=float, default=30.0)
    g.add_argument("--exp_t_offset", type=float, default=0.0)

    g = p.add_argument_group("Rendering")
    g.add_argument("--render_mode", type=str, default="density",
                   choices=["scatter", "density", "both"],
                   help="'density' = smoke-like dye field; 'scatter' = dots; 'both' = overlay.")
    g.add_argument("--density_bins", type=int, default=300,
                   help="Histogram resolution for density rendering.")
    g.add_argument("--density_sigma", type=float, default=0,
                   help="Gaussian smoothing sigma (in bins) for density field.")
    g.add_argument("--density_cmap", type=str, default="magma",
                   help="Colormap for density rendering (e.g. magma, hot, inferno, Greens).")
    g.add_argument("--density_vmax_quantile", type=float, default=0.98,
                   help="Clip colormap at this quantile to avoid outlier dominance.")

    g = p.add_argument_group("Aesthetics")
    g.add_argument("--particle_color", type=str, default="#FF00A6")
    g.add_argument("--particle_size",  type=float, default=8.0)
    g.add_argument("--particle_alpha", type=float, default=0.85)
    g.add_argument("--body_color",     type=str, default="#FFD700")
    g.add_argument("--bg_color",       type=str, default="#ffffff")
    g.add_argument("--bg_alpha",       type=float, default=0.92)
    g.add_argument("--figsize", type=float, nargs=2, default=[14, 7])
    g.add_argument("--dpi", type=int, default=150)
    g.add_argument("--xlim", type=float, nargs=2, default=None)
    g.add_argument("--ylim", type=float, nargs=2, default=None)
    g.add_argument("--trail_length", type=int, default=0)

    g = p.add_argument_group("Output")
    g.add_argument("--out_subdir", type=str, default="particle_images")
    g.add_argument("--device", type=str, default="cpu")

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    cfg = ParticlePlotConfig(
        sim_dir=args.sim_dir,
        mode=args.mode,
        it_start=args.it_start,
        it_end=args.it_end,
        it_spacing=args.it_spacing,
        seed_mode=args.seed_mode,
        boundary_n_particles=args.boundary_n_particles,
        boundary_n_z_layers=args.boundary_n_z_layers,
        boundary_jitter=args.boundary_jitter,
        tail_body_index=args.tail_body_index,
        tail_center_idx=args.tail_center_idx,
        tail_n_particles=args.tail_n_particles,
        seed_interval=args.seed_interval,
        seed_xrange=tuple(args.seed_xrange),
        seed_yrange=tuple(args.seed_yrange),
        seed_zrange=tuple(args.seed_zrange),
        seed_density=args.seed_density,
        line_start=tuple(args.line_start),
        line_end=tuple(args.line_end),
        line_n_particles=args.line_n_particles,
        exp_dir=args.exp_dir,
        exp_pattern=args.exp_pattern,
        exp_fps=args.exp_fps,
        exp_t_offset=args.exp_t_offset,
        render_mode=args.render_mode,
        density_bins=args.density_bins,
        density_sigma=args.density_sigma,
        density_cmap=args.density_cmap,
        density_vmax_quantile=args.density_vmax_quantile,
        particle_color=args.particle_color,
        particle_size=args.particle_size,
        particle_alpha=args.particle_alpha,
        body_color=args.body_color,
        bg_color=args.bg_color,
        bg_alpha=args.bg_alpha,
        figsize=tuple(args.figsize),
        dpi=args.dpi,
        xlim=tuple(args.xlim) if args.xlim else None,
        ylim=tuple(args.ylim) if args.ylim else None,
        trail_length=args.trail_length,
        out_subdir=args.out_subdir,
        device=args.device,
    )

    dispatch = {
        "2d":          run_2d,
        "3d_topview":  run_3d_topview,
        "3d_full":     run_3d_full,
    }
    dispatch[cfg.mode](cfg)


if __name__ == "__main__":
    main()





