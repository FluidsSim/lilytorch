<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world">
    <model name="toy_boat_hullonly_full">
      <pose>0 0 0 0 0 0</pose>

      <!-- =================================================================
           FULL-SCALE hull-ONLY copy of toy_boat.sdf for the seam-isolation
           test (instability B, tau-independent).  IDENTICAL hull mesh/scale/
           mass to the real base_link; keel, rudder and propeller links +
           joints are DELETED so the fluid sees a SINGLE body (no multi-body
           convexify SDF seams).

           Discriminator (run at the SAME settings as the exploding sim —
           h=0.05, kernel, 833:1, tau=0):
             * STABLE  -> the multi-body SDF seams are the blow-up source.
             * EXPLODES -> seams exonerated; it is the two-phase scheme /
                           waterline / coupling.

           The 1400 kg hull displaces ~1.4 m^3 against the ~1.61 m^3 hull
           envelope, so it floats at a draft comparable to the full boat.
           Roll stability (keel ballast) is gone, but any heel is far slower
           than the ~90-step fluid blow-up, so it does not confound the test.
           ================================================================= -->

      <!-- ===================== HULL (base link) ====================== -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>2.2206 0.3664 0 0 0 0</pose>
          <mass>1400.0</mass>
          <inertia>
            <ixx>677.0</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>4772.0</iyy> <iyz>0</iyz>
            <izz>4305.0</izz>
          </inertia>
        </inertial>
        <collision name="hull_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="hull_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>

    </model>
  </world>
</sdf>
