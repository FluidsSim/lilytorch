<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world">
    <model name="toy_boat">
      <pose>0 0 0 0 0 0</pose>

      <!-- =================================================================
           DSYHS sailing-yacht hull (~6 m) built from three watertight OBJ
           meshes (hull / keel / rudder) plus an analytical 3-blade
           propeller (inspired by the submarine example).

           MESH FRAME (native, as exported from Blender):
             X = length (fore-aft), 0 .. 6.04 m
             Y = vertical (UP),     keel tip -0.48 .. deck +0.94 m
             Z = beam (port-stbd),  -1.088 .. +1.088 m
           The simulation is Z-up, so gen_configs.py spawns the model with
           roll = +pi/2 (rotation about X) to map mesh-Y(up) -> world-Z(up).

           ONE COLLISION PER LINK (each fluid sub-body needs a unique link
           id, see the toy-boat history): hull = base_link, keel and rudder
           are their own links welded to the hull by fixed joints.

           Masses: the hull encloses ~0.85 m^3, so full-submersion buoyancy
           is ~850 kg.  Total mass is set to ~420 kg (light sportboat) so it
           floats at roughly half the hull volume.  Inertias are coarse
           box approximations in the native (mesh) frame; tune as needed.
           ================================================================= -->

      <!-- ===================== HULL (base link) ====================== -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>3.02 0.474 0 0 0 0</pose>
          <mass>280.0</mass>
          <inertia>
            <ixx>131.0</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>962.0</iyy> <iyz>0</iyz>
            <izz>870.0</izz>
          </inertia>
        </inertial>
        <collision name="hull_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>
        <visual name="hull_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>1 1 1</scale></mesh></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== KEEL (ballast) ======================== -->
      <link name="keel_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.518 -0.05 0 0 0 0</pose>
          <mass>120.0</mass>
          <inertia>
            <ixx>5.5</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>1.31</iyy> <iyz>0</iyz>
            <izz>6.78</izz>
          </inertia>
        </inertial>
        <collision name="keel_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>
        <visual name="keel_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>1 1 1</scale></mesh></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== RUDDER ================================ -->
      <link name="rudder_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>2.93 -0.17 0 0 0 0</pose>
          <mass>20.0</mass>
          <inertia>
            <ixx>0.67</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>3.55</iyy> <iyz>0</iyz>
            <izz>4.12</izz>
          </inertia>
        </inertial>
        <collision name="rudder_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>
        <visual name="rudder_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>1 1 1</scale></mesh></geometry>
          <material><ambient>0.7 0.2 0.15 1</ambient><diffuse>0.7 0.2 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Rigid welds attaching keel + rudder to the hull -->
      <joint name="joint_keel" type="fixed">
        <parent>base_link</parent><child>keel_link</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_rudder" type="fixed">
        <parent>base_link</parent><child>rudder_link</child><pose>0 0 0 0 0 0</pose>
      </joint>

      <!-- ============= ANALYTICAL PROPELLER (3 blades) ===============
           Hub axis along X (the boat's long axis); spins via a revolute
           joint driven by PropellerController torque.  Placed just forward
           of the keel (keel spans X 0.34-0.70) at X=0.20, slightly below
           the hull bottom (native Y=-0.10), on the centreline (Z=0).
           Three box blades at 120 deg around the X axis, each pitched
           0.35 rad about its radial span axis so rotation -> axial thrust.
           Blade poses precomputed as Rx(theta)*Ry(pitch). ================ -->
      <link name="propeller_hub">
        <pose>0.20 -0.10 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.226</mass>
          <inertia><ixx>1.02e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.71e-4</iyy><iyz>0</iyz><izz>1.71e-4</izz></inertia>
        </inertial>
        <collision name="propeller_hub_collision">
          <pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="propeller_hub_visual">
          <pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_0">
        <pose>0.20 -0.015 0.0 0 0.35 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_0_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_0_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_1">
        <pose>0.20 -0.1425 0.0736 2.06775 -0.17230 0.30618</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_1_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_1_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_2">
        <pose>0.20 -0.1425 -0.0736 -2.06775 -0.17230 -0.30618</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_2_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_2_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Revolute joint: propeller spins about the hull's long (X) axis -->
      <joint name="joint_propeller" type="revolute">
        <parent>base_link</parent><child>propeller_hub</child>
        <pose>0 0 0 0 0 0</pose>
        <axis><xyz>1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="joint_blade_0" type="fixed">
        <parent>propeller_hub</parent><child>blade_0</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_blade_1" type="fixed">
        <parent>propeller_hub</parent><child>blade_1</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_blade_2" type="fixed">
        <parent>propeller_hub</parent><child>blade_2</child><pose>0 0 0 0 0 0</pose>
      </joint>

    </model>
  </world>
</sdf>
