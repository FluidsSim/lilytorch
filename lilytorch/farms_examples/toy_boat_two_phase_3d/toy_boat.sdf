<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world">
    <model name="toy_boat">
      <pose>0 0 0 0 0 0</pose>

      <!-- =================================================================
           DSYHS sailing-yacht hull (~6 m) built from three watertight OBJ
           meshes (hull / keel / rudder) plus an analytical 3-blade
           propeller (inspired by the submarine example).

           MESH SCALE: the OBJ files are exported in mm-ish units (hull
           length 2224.7), so every mesh uses <scale>0.0026970</scale>
           (= 6.0 / 2224.7) → hull length = 6.0 m.  The <scale> only scales
           the mesh vertices, so the link/inertial/collision <pose> values
           below are already given in the SCALED (metre) frame.

           MESH FRAME (after scaling):
             X = length (fore-aft), -0.78 .. 5.22 m   (bow at +X, stern at -X)
             Y = vertical (UP),     keel tip -0.57 .. deck +0.84 m
             Z = beam (port-stbd),  -1.11 .. +1.11 m
           gen_configs.py spawns the model with roll = +pi/2 so mesh-Y(up)
           maps to world-Z(up).

           ONE COLLISION PER LINK (each fluid sub-body needs a unique link
           id): hull = base_link, keel and rudder are their own links welded
           to the hull by fixed joints.

           Masses: the hull encloses ~1.61 m^3 → full-submersion buoyancy
           ~1610 kg.  Total mass ~800 kg (light yacht) → floats ~half draft.
           Inertias are coarse box approximations in the scaled mesh frame.
           ================================================================= -->

      <!-- ===================== HULL (base link) ====================== -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- COM x=2.2206 sits over the centre of buoyancy at the design
               waterline (submerged-volume centroid x≈2.20), so the boat trims
               level: boat COM_x≈2.215 vs COB_x≈2.20 (offset +0.01 m). -->
          <pose>2.2206 0.3664 0 0 0 0</pose>
          <mass>600.0</mass>
          <inertia>
            <ixx>290.0</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>2045.0</iyy> <iyz>0</iyz>
            <izz>1845.0</izz>
          </inertia>
        </inertial>
        <collision name="hull_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="hull_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== KEEL (ballast) ======================== -->
      <link name="keel_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>2.4653 -0.2729 0 0 0 0</pose>
          <mass>180.0</mass>
          <inertia>
            <ixx>5.64</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>29.8</iyy>  <iyz>0</iyz>
            <izz>34.6</izz>
          </inertia>
        </inertial>
        <collision name="keel_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="keel_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== RUDDER ================================ -->
      <link name="rudder_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.2113 0.0233 0 0 0 0</pose>
          <mass>20.0</mass>
          <inertia>
            <ixx>0.86</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>0.20</iyy>  <iyz>0</iyz>
            <izz>1.06</izz>
          </inertia>
        </inertial>
        <collision name="rudder_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="rudder_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.7 0.2 0.15 1</ambient><diffuse>0.7 0.2 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Rigid welds attaching keel + rudder to the hull -->
      <joint name="joint_keel" type="fixed">
        <parent>base_link</parent><child>keel_link</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_rudder" type="fixed">
        <parent>base_link</parent><child>rudder_link</child><pose>0 0 0 0 0 0</pose>
      </joint>

      <!-- ============= ANALYTICAL PROPELLER (3 blades) ===============
           Hub axis along X (the boat's long axis); spins via a revolute
           joint driven by PropellerController torque.  Placed just forward
           (bow side, +X) of the keel — keel spans X 1.77..3.17 — at X=3.25,
           below the hull bottom (Y=-0.25), on the centreline (Z=0).  To put
           it aft instead (toward the stern/rudder at -X), move the hub +
           blade X to e.g. ~1.7 and flip the blade pitch sign for reverse.
           Three box blades at 120 deg around X, each pitched 0.35 rad about
           its radial span axis so rotation -> axial thrust. ============== -->
      <link name="propeller_hub">
        <pose>3.25 -0.25 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.226</mass>
          <inertia><ixx>1.02e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.71e-4</iyy><iyz>0</iyz><izz>1.71e-4</izz></inertia>
        </inertial>
        <collision name="propeller_hub_collision">
          <pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="propeller_hub_visual">
          <pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_0">
        <pose>3.25 -0.165 0.0 0 0.35 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_0_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_0_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_1">
        <pose>3.25 -0.2925 0.0736 2.06775 -0.17230 0.30618</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_1_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_1_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="blade_2">
        <pose>3.25 -0.2925 -0.0736 -2.06775 -0.17230 -0.30618</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.036</mass>
          <inertia><ixx>3.27e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.13e-6</iyy><iyz>0</iyz><izz>3.04e-5</izz></inertia>
        </inertial>
        <collision name="blade_2_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
        </collision>
        <visual name="blade_2_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.012 0.10 0.03</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Revolute joint: propeller spins about the hull's long (X) axis -->
      <joint name="joint_propeller" type="revolute">
        <parent>base_link</parent><child>propeller_hub</child>
        <pose>0 0 0 0 0 0</pose>
        <axis><xyz>1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="joint_blade_0" type="fixed">
        <parent>propeller_hub</parent><child>blade_0</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_blade_1" type="fixed">
        <parent>propeller_hub</parent><child>blade_1</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_blade_2" type="fixed">
        <parent>propeller_hub</parent><child>blade_2</child><pose>0 0 0 0 0 0</pose>
      </joint>

    </model>
  </world>
</sdf>
