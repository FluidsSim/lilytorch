<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world">
    <model name="toy_boat">
      <pose>0 0 0 0 0 0</pose>

      <!-- =================================================================
           DSYHS sailing-yacht hull (~6 m) built from three watertight OBJ
           meshes (hull / keel / rudder) plus an analytical 3-blade
           propeller (inspired by the submarine example).

           MESH SCALE: the OBJ files are exported in mm-ish units (hull
           length 2224.7), so every mesh uses <scale>0.0026970</scale>
           (= 6.0 / 2224.7) → hull length = 6.0 m.  The <scale> only scales
           the mesh vertices, so the link/inertial/collision <pose> values
           below are already given in the SCALED (metre) frame.

           MESH FRAME (after scaling):
             X = length (fore-aft), -0.78 .. 5.22 m   (bow at +X, stern at -X)
             Y = vertical (UP),     keel tip -0.57 .. deck +0.84 m
             Z = beam (port-stbd),  -1.11 .. +1.11 m
           gen_configs.py spawns the model with roll = +pi/2 so mesh-Y(up)
           maps to world-Z(up).

           ONE COLLISION PER LINK (each fluid sub-body needs a unique link
           id): hull = base_link, keel and rudder are their own links welded
           to the hull by fixed joints.

           Masses: the hull encloses ~1.61 m^3 → full-submersion buoyancy
           ~1610 kg.  Total mass ~800 kg (light yacht) → floats ~half draft.
           Inertias are coarse box approximations in the scaled mesh frame.
           ================================================================= -->

      <!-- ===================== HULL (base link) ====================== -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- 2-TON boat: 1631 hull + 315 keel + 20 rudder + ~34 prop = 2000 kg.
               Floats at 30% of the convex BDIM envelope -> hull wetted depth
               0.41 m (8.3 cells at h=0.05, well resolved).  Hull/keel split
               chosen so COM_x = COB_x = 2.045 (level trim, keel at x=1.5);
               COM at world-z 0.247, below the 0.40 waterline -> stable.
               Floating spawn: model origin world-z ~ +0.08. -->
          <pose>2.2206 0.3664 0 0 0 0</pose>
          <mass>1631.0</mass>
          <inertia>
            <ixx>789.0</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>5559.0</iyy> <iyz>0</iyz>
            <izz>5015.0</izz>
          </inertia>
        </inertial>
        <collision name="hull_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="hull_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/hull.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== KEEL (ballast) ======================== -->
      <link name="keel_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- 2000 kg at Y=-0.80: extreme keel for maximum righting moment.
               COM → Y≈-0.32, world Z≈-0.06 (0.46 m below waterline). -->
          <pose>1.5 -0.80 0 0 0 0</pose>
          <mass>315.0</mass>
          <inertia>
            <ixx>9.9</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>52.2</iyy>  <iyz>0</iyz>
            <izz>60.6</izz>
          </inertia>
        </inertial>
        <collision name="keel_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="keel_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/keel.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
        </visual>
      </link>

      <!-- ===================== RUDDER ================================ -->
      <link name="rudder_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.2113 0.0233 0 0 0 0</pose>
          <mass>20.0</mass>
          <inertia>
            <ixx>0.86</ixx>  <ixy>0</ixy> <ixz>0</ixz>
            <iyy>0.20</iyy>  <iyz>0</iyz>
            <izz>1.06</izz>
          </inertia>
        </inertial>
        <collision name="rudder_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
        </collision>
        <visual name="rudder_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><uri>../sdfs/DSYHS/OBJ/rudder.obj</uri><scale>0.0026970 0.0026970 0.0026970</scale></mesh></geometry>
          <material><ambient>0.7 0.2 0.15 1</ambient><diffuse>0.7 0.2 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Rigid welds attaching keel + rudder to the hull -->
      <joint name="joint_keel" type="fixed">
        <parent>base_link</parent><child>keel_link</child><pose>0 0 0 0 0 0</pose>
      </joint>
      <joint name="joint_rudder" type="fixed">
        <parent>base_link</parent><child>rudder_link</child><pose>0 0 0 0 0 0</pose>
      </joint>

      <!-- ============= ANALYTICAL PROPELLER (2 blades, deep) ========
           2-blade propeller at stern (X=0), centreline (Z=0), Y=-0.45.
           Deep enough that no blade reaches hull bottom (Y≈-0.094):
           blade 1 max Y = -0.45+0.22+0.11 = -0.12 < -0.094.
           Horizontal shaft. ====== -->
      <link name="propeller_hub">
        <pose>0.0 -0.45 0.0 0 0 0</pose>
        <!-- HEAVY assembly inertia (hub x10, blades x50): the ~2 kg propeller's
             rotational ADDED MASS (~0.45 kg*m^2 about the shaft) exceeded its own
             shaft inertia ~10x -> explicit-coupling added-mass divergence on the
             free revolute DOF (blow-up at the blade, worse on finer grids; tau=0
             and damping don't cure it).  Raising the assembly inertia to ~1.1
             kg*m^2 (= real prop+shaft+gearbox reflected inertia) stabilises the
             free joint; VERIFIED stable at tau=0 and tau=100. -->
        <inertial><pose>0 0 0 0 0 0</pose><mass>13.572</mass>
          <inertia><ixx>0.02443</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02851</iyy><iyz>0</iyz><izz>0.02851</izz></inertia></inertial>
        <collision name="propeller_hub_collision"><pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="propeller_hub_visual"><pose>0 0 0 0 1.5707963267948966 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      </link>

      <!-- Blade 0: pointing -Y (down), pitched +0.6 about Y -->
      <link name="blade_0">
        <pose>0.0 -0.67 0.0 0 0.6 0</pose>
        <inertial><pose>0 0 0 0 0 0</pose><mass>10.0</mass>
          <inertia><ixx>0.04865</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01665</iyy><iyz>0</iyz><izz>0.04865</izz></inertia></inertial>
        <collision name="blade_0_collision"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.10 0.22 0.10</size></box></geometry></collision>
        <visual name="blade_0_visual"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.10 0.22 0.10</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      </link>

      <!-- Blade 1: pointing +Y (up), pitched -0.6 about Y (opposite) -->
      <link name="blade_1">
        <pose>0.0 -0.23 0.0 0 -0.6 0</pose>
        <inertial><pose>0 0 0 0 0 0</pose><mass>10.0</mass>
          <inertia><ixx>0.04865</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01665</iyy><iyz>0</iyz><izz>0.04865</izz></inertia></inertial>
        <collision name="blade_1_collision"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.10 0.22 0.10</size></box></geometry></collision>
        <visual name="blade_1_visual"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.10 0.22 0.10</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
      </link>

      <joint name="joint_propeller" type="revolute">
        <parent>base_link</parent><child>propeller_hub</child><pose>0 0 0 0 0 0</pose>
        <!-- Horizontal shaft (no tilt): avoids P-factor yaw.  The 1000 kg
             deep keel provides enough righting moment to resist the remaining
             pitch from the thrust-line/COM offset (only 0.064 m now). -->
        <axis><xyz>1 0 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="joint_blade_0" type="fixed"><parent>propeller_hub</parent><child>blade_0</child><pose>0 0 0 0 0 0</pose></joint>
      <joint name="joint_blade_1" type="fixed"><parent>propeller_hub</parent><child>blade_1</child><pose>0 0 0 0 0 0</pose></joint>

    </model>
  </world>
</sdf>
